# ── Nexus Agent backend config ───────────────────────────────
# Copy to `.env` and fill in. NEVER commit the real .env.

# Bind address / port. Keep bound to loopback and expose only via
# Cloudflare Tunnel / Caddy — do NOT open this port on the firewall.
HOST=127.0.0.1
PORT=8787

# Secret bearer token. Every request (HTTP + WS) must send:
#   Authorization: Bearer <AGENT_TOKEN>
# Generate a strong one:  openssl rand -hex 32
AGENT_TOKEN=

# Workspace jail. The agent may ONLY read/write/exec inside this dir.
# Absolute path. Created on boot if missing.
WORKSPACE=/projects

# Comma-separated list of allowed CORS origins for the phone UI.
# Use the exact origin(s) you serve the Nexus frontend from.
# "*" is allowed for local dev only — tighten in production.
CORS_ORIGINS=*

# ── Default AI provider (Phase 0 /chat) ──────────────────────
# transport: "openai" or "anthropic"
PROVIDER_TRANSPORT=openai
PROVIDER_BASE_URL=https://openrouter.ai/api/v1
PROVIDER_KEY=
PROVIDER_MODEL=

# ── Command execution guard ──────────────────────────────────
# Max milliseconds a single /exec command may run before it's killed.
EXEC_TIMEOUT_MS=120000

# Optional strict allowlist. If set (comma-separated command names,
# e.g. "ls,cat,node,npm,git"), ONLY these binaries may be run.
# Leave empty to rely on the blacklist only.
EXEC_ALLOWLIST=

# ── Rate limiting ────────────────────────────────────────────
RATE_WINDOW_MS=60000
RATE_MAX=120
